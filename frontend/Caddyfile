# SITE_ADDRESS: ":80" for local/plain HTTP, or a domain (e.g. app.example.com) for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv

		# Angular builds hashed asset filenames, so their content never changes; everything
		# else (index.html, and any deep link rewritten to it) must be revalidated.
		@hashed path_regexp hashedasset \-[A-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@dynamic not path_regexp dynamicasset \-[A-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
		header @dynamic Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
