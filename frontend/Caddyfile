# SITE_ADDRESS: ":80" for local/plain HTTP, or a domain (e.g. app.example.com) for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv

		# Angular builds hashed asset filenames, so their content never changes. The fonts are
		# not hashed — index.html preloads them by name — but their name carries the weight and
		# the subset, so a different file is a different name. Everything else (index.html, and
		# any deep link rewritten to it) must be revalidated.
		@immutable {
			path_regexp hashedasset \-[A-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
		}
		@immutable_fonts path /fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @immutable_fonts Cache-Control "public, max-age=31536000, immutable"
		@dynamic {
			not path_regexp dynamicasset \-[A-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
			not path /fonts/*
		}
		header @dynamic Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
