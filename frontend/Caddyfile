# SITE_ADDRESS: ":80" for local/plain HTTP, or a domain (e.g. app.example.com) for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
