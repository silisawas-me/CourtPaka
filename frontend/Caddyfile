# SITE_ADDRESS: ":80" for local/plain HTTP, or a domain (e.g. app.example.com) for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Everything the app loads is its own. Two allowances, each for a reason:
		#  - style-src 'unsafe-inline': Angular Material sets styles at runtime, and the build
		#    inlines the critical CSS into index.html.
		#  - the one script hash: the build loads the full stylesheet with
		#    onload="this.media='all'". Without it the page renders unstyled. If a build ever
		#    changes that attribute, the hash has to change with it.
		# Slips are shown from blob: URLs made in the page; nothing is framed or framable.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# The app asks for none of these, so nothing embedded in it may either.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv

		# Angular builds hashed asset filenames, so their content never changes. The fonts are
		# not hashed, because index.html preloads them by name, so they get a long cache but not
		# an immutable one: replacing a font file keeps its name, and a year would be a year of
		# stale glyphs. Everything else (index.html, and any deep link rewritten to it) must be
		# revalidated.
		@immutable {
			path_regexp hashedasset \-[A-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
		}
		@fonts path_regexp fontfile ^/fonts/[^/]+\.woff2?$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @fonts Cache-Control "public, max-age=2592000"
		@dynamic {
			not path_regexp dynamicasset \-[A-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
			not path_regexp fontfilecheck ^/fonts/[^/]+\.woff2?$
		}
		header @dynamic Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
