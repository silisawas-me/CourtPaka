# Copy to .env next to docker-compose.yml on the server, fill in, then `chmod 600 .env`.
# Never commit the filled-in file (PRD 9.3).

# Public origin and domain. SITE_ADDRESS drives Caddy's certificate; APP_BASE_URL builds email links.
SITE_ADDRESS=uat.example.com
APP_BASE_URL=https://uat.example.com

# Database. Use a long random password; it never leaves this machine.
POSTGRES_DB=courtpaka
POSTGRES_USER=courtpaka
POSTGRES_PASSWORD=

# Privacy policy version users accept at registration (PDPA, PRD 8).
PRIVACY_POLICY_VERSION=2026-09-01
# Which version of the venue agreement a venue accepts when it applies (PRD US-10).
# Move it when the wording changes; venues keep the version they accepted.
VENUE_AGREEMENT_VERSION=2026-09-01

# The address that may approve, turn away and suspend venues (PRD US-20).
# Configuration rather than a setting in the app: there is no endpoint that grants it,
# so becoming one means having this file. The account still has to exist and sign in.
PLATFORM_ADMIN_EMAIL=

# Images to run. The deploy workflow rewrites these to the commit it is deploying.
API_IMAGE=ghcr.io/OWNER/courtpaka-api:latest
WEB_IMAGE=ghcr.io/OWNER/courtpaka-web:latest
